@model IEnumerable<Lab09.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0">Product Management</h2>
            <p class="text-muted small mb-0">Manage and view catalog products with CRUD operations</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> + Add New Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="ps-3" style="width: 70px;">ID</th>
                            <th style="width: 90px;">Image</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th class="text-end">Price</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-3" style="min-width: 160px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var badgeClass = item.Status?.Trim() switch
                                {
                                    "Active" => "bg-success",
                                    "Inactive" => "bg-secondary",
                                    "Out of Stock" => "bg-danger",
                                    _ => "bg-info text-dark"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@item.Id</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Image))
                                        {
                                            <img src="@item.Image" alt="@item.Title"
                                                 style="width: 55px; height: 50px; object-fit: cover;"
                                                 class="rounded border shadow-sm"
                                                 onerror="this.onerror=null;this.src='https://placehold.co/60x60?text=No+Img';" />
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">No Img</span>
                                        }
                                    </td>
                                    <td class="fw-semibold">@item.Title</td>
                                    <td class="text-muted small">@item.Description</td>
                                    <td class="text-end fw-bold text-primary">@item.Price.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @(item.Quantity > 0 ? "bg-light text-dark border" : "bg-warning text-dark")">
                                            @item.Quantity
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass px-2 py-1">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-primary" title="Edit Product">
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger" title="Delete Product">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <p class="fs-5 mb-2">No products available in the database.</p>
                                        <a asp-action="Create" class="btn btn-sm btn-outline-primary">
                                            Add First Product
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
