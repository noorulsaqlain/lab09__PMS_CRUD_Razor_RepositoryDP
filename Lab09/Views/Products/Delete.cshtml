@model Lab09.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-danger shadow-sm rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold">Delete Confirmation</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning!</strong> Are you sure you want to permanently delete this product? This action cannot be undone.
                    </div>

                    <div class="d-flex align-items-center mb-3 p-3 bg-light rounded">
                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Title"
                                 style="width: 70px; height: 70px; object-fit: cover;"
                                 class="rounded border me-3"
                                 onerror="this.onerror=null;this.src='https://placehold.co/70x70?text=No+Img';" />
                        }
                        <div>
                            <h5 class="mb-1 fw-bold">@Model.Title</h5>
                            <p class="text-muted small mb-0">@Model.Description</p>
                        </div>
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Product ID</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Price</dt>
                        <dd class="col-sm-8 text-primary fw-bold">$@Model.Price.ToString("N0")</dd>

                        <dt class="col-sm-4 text-muted">Quantity</dt>
                        <dd class="col-sm-8">@Model.Quantity in stock</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Status</span>
                        </dd>
                    </dl>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4 pt-3 border-top d-flex justify-content-between">
                        @Html.AntiForgeryToken()
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            Yes, Delete Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
